# Copy this file to .env and fill in your API key
AICHAT_API_KEY=sk-your-key-here
AICHAT_API_BASE=https://api.openai.com/v1
AICHAT_MODEL=gpt-3.5-turbo
AICHAT_MAX_TOKENS=1024
AICHAT_TIMEOUT=60
AICHAT_HOST=0.0.0.0
AICHAT_PORT=8080

# Custom system prompt (leave empty to disable)
AICHAT_SYSTEM_PROMPT=
